# ===== 数据库配置 =====
# Docker 部署时由 docker-compose.yml 注入，本地开发可覆盖
# 生产环境务必修改 DB_PASSWORD 为强密码（建议 openssl rand -base64 24）
DB_PASSWORD=reimburse123
DATABASE_URL=postgresql+asyncpg://reimburse:${DB_PASSWORD}@localhost:15432/reimbursement

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM 配置 =====
# Provider: qwen | openai | deepseek | anthropic
LLM_PROVIDER=qwen
# 在千问控制台获取: https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=
# 视觉模型推荐 qwen3-vl-plus / qwen-vl-max / gpt-4o
LLM_MODEL=qwen3-vl-plus
# 文本模型（用于分类、项目抽取等非视觉任务），留空则按规则推导
LLM_TEXT_MODEL=
# 自定义 base_url（一般留空走 Provider 默认）
LLM_BASE_URL=

# ===== 分层模型路由（可选，留空走默认路由表）=====
# 默认路由见 backend/app/config.py 的 MODEL_ROUTING：
#   nlu_classify / fee_classify / project_extract -> qwen-turbo（高频低复杂度）
#   invoice_ocr                                  -> qwen3-vl-plus（必须 VL）
#   insight_narrate / batch_describe             -> qwen-plus（长文本/推理）
# 通过环境变量可覆盖某类任务的模型，便于灰度切换，例：
#   LLM_NLU_MODEL=deepseek-chat     # NLU 意图识别换用 deepseek
#   LLM_NARRATE_MODEL=qwen-max      # 洞察叙述换用更强模型
LLM_NLU_MODEL=
LLM_FEE_CLASSIFY_MODEL=
LLM_PROJECT_EXTRACT_MODEL=
LLM_OCR_MODEL=
LLM_NARRATE_MODEL=
LLM_BATCH_MODEL=

# ===== Agent 模式（Function-Calling Agent，Step 3.1）=====
# false（默认）：走原 NLU + FSM + ActionExecutor 路径
# true：走 AgentCore + Tool function-calling 路径
# 灰度策略：先 false 全量兜底，验证 tool 注册与 AgentCore 正常后切 true
AGENT_MODE_ENABLED=false
# Agent 单次推理最大步数（ReAct 循环上限，防止无限调用）
AGENT_MAX_STEPS=5
# 灰度比例（0.0-1.0，仅当 AGENT_MODE_ENABLED=true 时生效）
# 0.1 表示 10% 用户启用 Agent mode（按 user_id hash 取模）
AGENT_MODE_GRAY_RATIO=0.0

# ===== Embedding 配置（RAG 意图检索，Step 2.1）=====
# backend: dashscope（阿里云 dashscope SDK）| openai（OpenAI 兼容协议，复用 LLM_API_KEY+LLM_BASE_URL）| local（sentence-transformers，离线）
LLM_EMBEDDING_BACKEND=openai
# dashscope: text-embedding-v2 | openai: text-embedding-v3 等
LLM_EMBEDDING_MODEL=text-embedding-v3
LLM_EMBEDDING_DIM=1024
# local 后端模型（sentence-transformers）
LLM_EMBEDDING_MODEL_LOCAL=BAAI/bge-small-zh-v1.5

# ===== 对话流式响应（SSE，Step 1.2）=====
DIALOG_STREAM_ENABLED=true

# ===== JWT 配置（员工端 Portal 鉴权）=====
# 必填，生产环境务必使用强随机字符串（建议 openssl rand -hex 32 生成）
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== CORS 配置 =====
# 多个域名用逗号分隔，例: http://localhost:5173,https://your-domain.com
# 生产环境必须设置为实际前端域名，禁止使用通配符
CORS_ALLOW_ORIGINS=http://localhost:5173

# ===== 在线发票验真配置 =====
# VERIFY_PROVIDER: aliyun（主通道，阿里云云鉴）| baidu（备用通道，百度智能云）
VERIFY_PROVIDER=aliyun
# 阿里云云鉴 AppCode（购买后从云市场控制台获取）
ALIYUN_VERIFY_APPCODE=
ALIYUN_VERIFY_APPSECRET=
# 百度智能云凭据（备用通道）
VERIFY_API_KEY=
VERIFY_SECRET_KEY=

# ===== 企业微信配置（未启用可留空）=====
# 在企微管理后台获取: https://work.weixin.qq.com/
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=
WECOM_WEB_BASE=
WECOM_WEB_BASE=
