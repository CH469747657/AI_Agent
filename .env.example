# ===== LLM 配置 =====
# Provider: qwen | openai | deepseek | anthropic
LLM_PROVIDER=qwen
# 在千问控制台获取: https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=
# 视觉模型推荐 qwen3-vl-plus / qwen-vl-max / gpt-4o
LLM_MODEL=qwen3-vl-plus
# 文本模型（用于分类、项目抽取等非视觉任务），留空则按规则推导
LLM_TEXT_MODEL=
# 自定义 base_url（一般留空走 Provider 默认）
LLM_BASE_URL=

# ===== JWT 配置（员工端 Portal 鉴权）=====
# 必填，生产环境务必使用强随机字符串（建议 openssl rand -hex 32 生成）
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== CORS 配置 =====
# 多个域名用逗号分隔，例: http://localhost:5173,https://your-domain.com
CORS_ALLOW_ORIGINS=http://localhost:5173

# ===== 在线发票验真配置 =====
# VERIFY_PROVIDER: aliyun（主通道，阿里云云鉴）| baidu（备用通道，百度智能云）
VERIFY_PROVIDER=aliyun
# 阿里云云鉴 AppCode（购买后从云市场控制台获取）
# 获取方式: https://market.aliyun.com/detail/cmapi00040252
ALIYUN_VERIFY_APPCODE=
# 百度智能云凭据（备用通道）
# 获取方式: https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
VERIFY_API_KEY=
VERIFY_SECRET_KEY=

# ===== 企业微信配置（未启用可留空）=====
# 在企微管理后台获取: https://work.weixin.qq.com/
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=
WECOM_WEB_BASE=
